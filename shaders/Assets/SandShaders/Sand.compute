// Granular medium for Besiege: position-based grains on a uniform grid.
//
// One kernel set serves sand, wet sand, dust, snow and gravel: they differ only in
// a MaterialParams row, never in a code path. Materials are per particle, so a
// digger can move gravel into snow and the contact between them is the average of
// the two rows.
//
// Order per substep, driven from C#:
//     CSClearForces -> CSPredict -> CSClearGrid -> CSBuildGrid
//         -> CSSolve  (iterated)
//         -> CSFinalize
//
// Besiege runs physics at 100 Hz, so this is NOT stepped every FixedUpdate; the
// field has its own rate and its own substeps. See docs/DESIGN.md.

#pragma kernel CSClearForces
#pragma kernel CSPredict
#pragma kernel CSClearGrid
#pragma kernel CSBuildGrid
#pragma kernel CSSolve
#pragma kernel CSFinalize

#define THREADS 64

// Cell capacity is fixed rather than sorted: a full radix sort per substep costs
// more than the grains lost to a full cell, and a full cell only happens where the
// medium is already denser than it should be.
#define CELL_CAPACITY 16

// Flags packed above the material index in Particle.material.
#define FLAG_WET      0x00000100
#define FLAG_ASLEEP   0x00000200
#define FLAG_DEAD     0x00000400

// A grain younger than this does not push blocks: a region dropped into the ground
// resolves a huge overlap on its first step, and without this that becomes a launch.
#define SETTLE_SECONDS 0.35

// Ceiling on what one grain may push a block with, as a multiple of its own weight.
#define MAX_WEIGHT_MULTIPLE 40.0
#define MATERIAL_MASK 0x000000FF

// Block forces are accumulated with integer atomics -- HLSL has no float
// InterlockedAdd -- so they travel as fixed point and are scaled back in C#.
#define FORCE_SCALE 4096.0

struct Particle
{
    float3 pos;
    float3 prevPos;    // position before this substep's solve; velocity comes from it
    float3 vel;
    uint   material;   // material index in the low 8 bits, flags above
    uint   colour;     // packed RGBA8, already multiplied by the emitter's tint
    float  packing;    // how compacted this grain has been; snow remembers, sand does not
    float  wetTimer;   // seconds of wetness left once out of water
    float  life;       // seconds of lifetime left
    float  age;        // seconds since it was emitted
};

struct MaterialParams
{
    float radius;
    float invMass;
    float friction;
    float cohesion;
    float restitution;
    float airDrag;
    float waterDrag;
    float buoyancy;      // density of water over density of grain
    float packGain;      // how much sustained pressure adds to cohesion
    float wetCohesion;   // cohesion added while FLAG_WET is set
    float wetSeconds;    // how long wetness outlives leaving the water
    int   wetMaterial;   // material to become when wet; -1 to stay as-is
    float adhesion;      // CPU solver and bed only, for now: kept so the layout matches
    float firmness;
    float packLimit;
    float digSpeed;
};

// kind in the low 8 bits, block index above: 0 box, 1 sphere, 2 capsule.
#define SHAPE_BOX     0
#define SHAPE_SPHERE  1
#define SHAPE_CAPSULE 2

struct Shape
{
    float3 centre;
    float  radius;       // sphere/capsule radius
    float4 rot;          // rotation, as a quaternion
    float3 halfExtent;   // box half extents; capsule half length in .y
    uint   kindBlock;
    float3 pointVel;     // velocity of the shape at its centre
    float  movable;      // 0 for level geometry, 1 for a block that can be pushed
};

RWStructuredBuffer<Particle> _Particles;
RWStructuredBuffer<uint>     _GridCounts;
RWStructuredBuffer<uint>     _GridItems;
RWStructuredBuffer<int>      _BlockForces;   // 6 ints per block: force xyz, torque xyz
StructuredBuffer<MaterialParams> _Materials;
StructuredBuffer<Shape>          _Shapes;

// The wave simulation's own height texture, bound straight from
// BuoyancyManager.waveData.outputData -- nothing is read back to do this.
Texture2D<float4> _WaveTex;
Texture2D<float4> _TerrainTex;

uint   _ParticleCount;
uint   _ShapeCount;
float3 _GridOrigin;
float  _CellSize;
uint3  _GridDims;
float3 _Gravity;
float  _Dt;
float  _WaterEnabled;     // 0 when the level has no wave simulation
float3 _WaveOrigin;       // Dimensions.firstCorner
float2 _WaveScale;        // resolution over world size, XZ
float  _WaveLevel;        // world Y that a texture value of 0 corresponds to
float  _SleepSpeed;

// ---------------------------------------------------------------- small helpers

float3 qrot(float4 q, float3 v)
{
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}

float3 qinvrot(float4 q, float3 v)
{
    return qrot(float4(-q.xyz, q.w), v);
}

uint cellIndex(float3 p)
{
    int3 c = (int3)floor((p - _GridOrigin) / _CellSize);
    c = clamp(c, int3(0, 0, 0), (int3)_GridDims - 1);
    return (uint)(c.x + c.y * _GridDims.x + c.z * _GridDims.x * _GridDims.y);
}

// Water surface height at a world position, or a value far below everything when
// the level has no wave simulation.
float waterHeight(float3 p)
{
    if (_WaterEnabled < 0.5) return -1e9;
    int2 t = (int2)((p.xz - _WaveOrigin.xz) * _WaveScale);
    float4 w = _WaveTex.Load(int3(t, 0));
    return _WaveLevel + w.r;
}

void addBlockForce(uint blockIndex, float3 force, float3 lever)
{
    float3 torque = cross(lever, force);
    uint b = blockIndex * 6;
    InterlockedAdd(_BlockForces[b + 0], (int)(force.x * FORCE_SCALE));
    InterlockedAdd(_BlockForces[b + 1], (int)(force.y * FORCE_SCALE));
    InterlockedAdd(_BlockForces[b + 2], (int)(force.z * FORCE_SCALE));
    InterlockedAdd(_BlockForces[b + 3], (int)(torque.x * FORCE_SCALE));
    InterlockedAdd(_BlockForces[b + 4], (int)(torque.y * FORCE_SCALE));
    InterlockedAdd(_BlockForces[b + 5], (int)(torque.z * FORCE_SCALE));
}

// Signed distance and outward normal for one shape, in world space.
void shapeDistance(Shape s, float3 p, out float dist, out float3 normal)
{
    uint kind = s.kindBlock & 0xFF;
    float3 local = qinvrot(s.rot, p - s.centre);

    if (kind == SHAPE_SPHERE)
    {
        float len = max(length(local), 1e-6);
        dist = len - s.radius;
        normal = qrot(s.rot, local / len);
        return;
    }
    if (kind == SHAPE_CAPSULE)
    {
        float3 q = local;
        q.y -= clamp(q.y, -s.halfExtent.y, s.halfExtent.y);
        float len = max(length(q), 1e-6);
        dist = len - s.radius;
        normal = qrot(s.rot, q / len);
        return;
    }

    // Box: the usual exterior/interior split, so a grain that ends up inside is
    // pushed out of the nearest face rather than being left there.
    float3 d = abs(local) - s.halfExtent;
    float3 outside = max(d, 0.0);
    float outLen = length(outside);
    if (outLen > 1e-6)
    {
        dist = outLen;
        normal = qrot(s.rot, sign(local) * (outside / outLen));
    }
    else
    {
        // deepest-penetrating axis wins
        float3 a = -d;
        float m = min(a.x, min(a.y, a.z));
        float3 n = float3(a.x <= m ? sign(local.x) : 0.0,
                          a.y <= m ? sign(local.y) : 0.0,
                          a.z <= m ? sign(local.z) : 0.0);
        dist = -m;
        normal = qrot(s.rot, normalize(n + 1e-6));
    }
}

// ------------------------------------------------------------------- the kernels

[numthreads(THREADS, 1, 1)]
void CSClearForces(uint3 id : SV_DispatchThreadID)
{
    _BlockForces[id.x] = 0;
}

[numthreads(THREADS, 1, 1)]
void CSClearGrid(uint3 id : SV_DispatchThreadID)
{
    _GridCounts[id.x] = 0;
}

[numthreads(THREADS, 1, 1)]
void CSPredict(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    Particle p = _Particles[id.x];
    MaterialParams m = _Materials[p.material & MATERIAL_MASK];

    float surface = waterHeight(p.pos);
    bool submerged = p.pos.y < surface;

    // Gravity is read from the level every step and never assumed: the space levels
    // have their own, and a player may have turned it off entirely.
    p.prevPos = p.pos;

    p.age += _Dt;
    p.life -= _Dt;
    if (p.life <= 0.0)
    {
        p.material |= FLAG_DEAD;
        _Particles[id.x] = p;
        return;
    }

    float3 accel = _Gravity;
    if (submerged) accel -= _Gravity * m.buoyancy;

    // A vacuum damps nothing, so drag is only air drag where there is air. Dust is
    // the material this matters to: its drag is what makes it hang.
    float drag = submerged ? m.waterDrag : m.airDrag;
    p.vel += accel * _Dt;
    p.vel *= saturate(1.0 - drag * _Dt);

    p.pos += p.vel * _Dt;

    if (submerged)
    {
        p.material |= FLAG_WET;
        p.wetTimer = m.wetSeconds;
        if (m.wetMaterial >= 0)
            p.material = (uint)m.wetMaterial | (p.material & ~MATERIAL_MASK);
    }
    else if (p.wetTimer > 0.0)
    {
        p.wetTimer -= _Dt;
        if (p.wetTimer <= 0.0) p.material &= ~FLAG_WET;
    }

    _Particles[id.x] = p;
}

[numthreads(THREADS, 1, 1)]
void CSBuildGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    uint cell = cellIndex(_Particles[id.x].pos);
    uint slot;
    InterlockedAdd(_GridCounts[cell], 1, slot);
    if (slot < CELL_CAPACITY) _GridItems[cell * CELL_CAPACITY + slot] = id.x;
}

[numthreads(THREADS, 1, 1)]
void CSSolve(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    Particle p = _Particles[id.x];
    if (p.material & FLAG_DEAD) return;
    MaterialParams m = _Materials[p.material & MATERIAL_MASK];

    float3 correction = 0.0;
    float  pressure   = 0.0;

    // Cohesion is what separates these materials more than friction does: it is why
    // wet sand holds a dug face and dry sand slumps to its angle of repose.
    float cohesion = m.cohesion + p.packing * m.packGain;
    if (p.material & FLAG_WET) cohesion += m.wetCohesion;

    int3 base = (int3)floor((p.pos - _GridOrigin) / _CellSize);

    [loop] for (int dz = -1; dz <= 1; dz++)
    [loop] for (int dy = -1; dy <= 1; dy++)
    [loop] for (int dx = -1; dx <= 1; dx++)
    {
        int3 c = base + int3(dx, dy, dz);
        if (any(c < 0) || any(c >= (int3)_GridDims)) continue;
        uint cell = (uint)(c.x + c.y * _GridDims.x + c.z * _GridDims.x * _GridDims.y);
        uint n = min(_GridCounts[cell], CELL_CAPACITY);

        [loop] for (uint k = 0; k < n; k++)
        {
            uint j = _GridItems[cell * CELL_CAPACITY + k];
            if (j == id.x) continue;

            Particle q = _Particles[j];
            MaterialParams mq = _Materials[q.material & MATERIAL_MASK];

            float3 d = p.pos - q.pos;
            float  dist = length(d);
            if (dist < 1e-6) continue;

            float rest = m.radius + mq.radius;
            float3 n3 = d / dist;

            if (dist < rest)
            {
                // Non-penetration, split by inverse mass so a gravel grain shoves a
                // dust mote rather than the other way round.
                float overlap = rest - dist;
                float wsum = m.invMass + mq.invMass;
                if (wsum <= 0.0) continue;
                correction += n3 * (overlap * m.invMass / wsum);
                pressure   += overlap;

                // Restitution has to be applied where the normal is known. In a
                // position solver a bounce is extra separation proportional to the
                // speed of approach -- this is what makes gravel lively and snow
                // dead, from one number.
                float vnp = dot(p.vel - q.vel, n3);
                float e = 0.5 * (m.restitution + mq.restitution);
                if (vnp < 0.0 && e > 0.0)
                    correction += n3 * (-vnp * e * _Dt * m.invMass / wsum);

                // Friction acts on the tangential part of the relative velocity.
                // Averaging the two materials is what makes a mixed pile behave.
                float3 rel = p.vel - q.vel;
                float3 tang = rel - n3 * dot(rel, n3);
                float mu = 0.5 * (m.friction + mq.friction);
                correction -= tang * min(mu * overlap / max(length(tang) * _Dt, 1e-6), 1.0) * _Dt;
            }
            else if (dist < rest * 2.0 && cohesion > 0.0)
            {
                float t = 1.0 - (dist - rest) / rest;
                correction -= n3 * (cohesion * t * t * _Dt * _Dt);
            }
        }
    }

    // Level geometry and machine blocks, as analytic shapes. Besiege's blocks are
    // 342 boxes, 138 spheres and 67 capsules across all 104 prefabs, with five
    // convex meshes in total -- so this covers the machine without a triangle.
    [loop] for (uint s = 0; s < _ShapeCount; s++)
    {
        Shape sh = _Shapes[s];
        float dist;
        float3 normal;
        shapeDistance(sh, p.pos, dist, normal);

        if (dist < m.radius)
        {
            float overlap = m.radius - dist;
            correction += normal * overlap;
            pressure   += overlap;

            float vns = dot(p.vel - sh.pointVel, normal);
            if (vns < 0.0 && m.restitution > 0.0)
                correction += normal * (-vns * m.restitution * _Dt);

            float3 rel = p.vel - sh.pointVel;
            float3 tang = rel - normal * dot(rel, normal);
            correction -= tang * min(m.friction * overlap / max(length(tang) * _Dt, 1e-6), 1.0) * _Dt;

            // Newton's third law, back to the block that pushed. Only blocks are
            // movable; level geometry takes the push and ignores it.
            if (sh.movable > 0.5 && p.age > SETTLE_SECONDS)
            {
                float mass = 1.0 / max(m.invMass, 1e-6);
                float3 force = -normal * (overlap * mass) / max(_Dt * _Dt, 1e-9);

                // The reaction force of a position solver is overlap over dt squared,
                // which is unbounded as overlap grows. Cap it against the grain's own
                // weight so a bad step cannot fire the machine across the level.
                float cap = mass * max(length(_Gravity), 1.0) * MAX_WEIGHT_MULTIPLE;
                float mag = length(force);
                if (mag > cap) force *= cap / mag;

                addBlockForce(sh.kindBlock >> 8, force, p.pos - sh.centre);
            }
        }
    }

    // One iteration may not move a grain further than its own radius: a single deep
    // overlap would otherwise teleport it, and the velocity the position solve reads
    // back from that is enormous.
    float maxMove = m.radius;
    float moved = length(correction);
    if (moved > maxMove) correction *= maxMove / moved;

    p.pos += correction;
    p.packing = lerp(p.packing, saturate(pressure / max(m.radius, 1e-6)), 0.1);
    _Particles[id.x] = p;
}

[numthreads(THREADS, 1, 1)]
void CSFinalize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    Particle p = _Particles[id.x];

    // Position-based: the solve moved positions, and the velocity that comes out of
    // it is what those moves imply. Reading velocity back this way is what makes
    // stacking stable -- an impulse-based update would jitter a resting pile.
    p.vel = (p.pos - p.prevPos) / max(_Dt, 1e-9);

    // In free fall with no gravity there is nothing to settle towards, so sleeping
    // is switched off rather than sending a drifting cloud to sleep in mid-air.
    if (length(_Gravity) > 0.01 && length(p.vel) < _SleepSpeed)
        p.material |= FLAG_ASLEEP;
    else
        p.material &= ~FLAG_ASLEEP;

    _Particles[id.x] = p;
}

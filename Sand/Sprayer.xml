<Block>
	<Debug>false</Debug>
	<ID>1</ID>
	<Name>Sand sprayer</Name>
	<Mass>0.6</Mass>
	<SearchKeywords>
		<Keyword>sand</Keyword>
		<Keyword>sprayer</Keyword>
		<Keyword>gravel</Keyword>
		<Keyword>snow</Keyword>
		<Keyword>dust</Keyword>
		<Keyword>hopper</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>


	<!-- The modid is the GUID the game generated for this mod on its first load, not
	     one written by hand. A modid that is present is the only thing consulted when
	     the module is resolved, so an invented GUID matches no registered module at
	     all. -->
	<Modules>
		<Sprayer modid="e847c434-0ffb-456a-acf9-56800bcb2f77">
		</Sprayer>
	</Modules>

	<!-- A pipe (Quaternius, public domain), its open end at +Z: the block's forward
	     face, the direction the medium leaves, and so up from whatever it is placed
	     on. Converted with tools/glb2obj.py (its zup and uv flags): one unit tall, 0.93 across,
	     centred, so it stands from z = 0 to 1 on its base. -->
	<Mesh name="Sprayer_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="1.0" y="1.0" z="1.0" />
	</Mesh>

	<Texture name="Sprayer_text" />

	<!-- Looking down on the open end at about thirty-five degrees: x = -90 stands a
	     block upright in its tile (notes repo, 02-blocks.md), and past it the top tips
	     towards the camera. A pipe is round, so y would only spin it. -->
	<Icon>
		<Position x="0.0" y="0.0" z="-1.1" />
		<Rotation x="-125.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Icon>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.9" y="0.9" z="1.0" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" />
	</BasePoint>

	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>

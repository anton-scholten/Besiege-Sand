<Mod>
	<Name>Sand</Name>
	<Author>wizz6rd</Author>
	<Version>0.0.2</Version>

	<Description>
	Adds sand, wet sand, dust, snow, gravel, mud and glue as placeable and interactive materials.
	Paint it onto any level; machines press ruts into it, plough it and blow craters in it.
	</Description>

	<Debug>false</Debug>

	<!-- No LoadInTitleScreen on purpose. A mod loaded early has its block prefabs numbered
	     before later mods join the id sort, and a later mod with a smaller GUID then makes
	     the sprayer take that mod's block, mapper and behaviour. Keep it off. -->

	<MultiplayerCompatible>true</MultiplayerCompatible>

	<!-- The mod's picture on the Workshop page: Thumbnail_2.png, the artwork, copied in beside
	     the block definitions by tools/make-thumbnail.sh. Steam's cap on a preview is 1024 KiB
	     and it refuses an item over that with nothing said about which file, which would break
	     every upload of the mod while the game loads it perfectly well; the copy is 768px for
	     that reason, and make-thumbnail.sh checks it. -->
	<Icon name="SandThumbnail" />

	<Assemblies>
		<Assembly path="SandAssembly.dll" />
	</Assemblies>

	<Resources>
		<!-- The Workshop picture: the artwork, copied in from Thumbnail_2.png at the top of
		     the repository by tools/make-thumbnail.sh. -->
		<Texture name="SandThumbnail" path="Thumbnail.png" />
		<!-- The sand panel's folded button: made by tools/make-icon.sh out of
		     Scripts/SandIcon.cs, and loaded back by SandHud.PileSprite. -->
		<Texture name="SandIcon" path="Icon.png" />
	</Resources>




<!-- This value is automatically generated. Do not change it or you may break machine&level save files. -->
<ID>e847c434-0ffb-456a-acf9-56800bcb2f77</ID>
</Mod>

<Mod>
	<Name>Sand</Name>
	<Author>wizz6rd</Author>
	<Version>0.0.1</Version>

	<Description>
	Granular media for Besiege: sand, wet sand, dust, snow and gravel, as a level-wide
	simulation that machines can dig, scoop and be buried by.

	Adds the Media Sprayer block. Pick a medium and it presets its rate, speed and
	spread; every number stays editable afterwards. The medium leaves through the
	crate's open face.

	Also carries a capability probe that writes a report to Player.log, so the
	simulation is tuned against what this machine actually supports rather than
	against guesses. Press F9 in any scene for a report covering it.
	</Description>

	<Debug>false</Debug>

	<!-- No LoadInTitleScreen on purpose. A mod loaded early has its block prefabs numbered
	     before later mods join the id sort, and a later mod with a smaller GUID then makes
	     the sprayer take that mod's block, mapper and behaviour. Keep it off. -->

	<MultiplayerCompatible>true</MultiplayerCompatible>

	<Assemblies>
		<Assembly path="SandAssembly.dll" />
	</Assemblies>

	<Blocks>
		<Block path="Sprayer.xml" />
	</Blocks>

	<Entities>
		<Entity path="RegionBoxEntity.xml" />
		<Entity path="RegionCylinderEntity.xml" />
		<Entity path="RegionSphereEntity.xml" />
		<Entity path="SprayerEntity.xml" />
	</Entities>

	<Resources>
		<Mesh name="Sprayer_mesh" path="SprayerBlock.obj" />
		<Texture name="Sprayer_text" path="Cardboard.png" />

		<Mesh name="RegionBox_mesh" path="RegionBox.obj" />
		<Mesh name="RegionCylinder_mesh" path="RegionCylinder.obj" />
		<Mesh name="RegionSphere_mesh" path="RegionSphere.obj" />

		<!-- Level editor icons. Generated by tools/genicons.py rather than rendered:
		     rendering the object would need a Unity editor, and a flat isometric
		     shape in the medium's own colour says what the object is at 128 px. -->
		<Texture name="SandBox_icon" path="SandBox_icon.png" />
		<Texture name="SandCylinder_icon" path="SandCylinder_icon.png" />
		<Texture name="SandBall_icon" path="SandBall_icon.png" />
		<Texture name="SandSprayer_icon" path="SandSprayer_icon.png" />
	</Resources>




<!-- This value is automatically generated. Do not change it or you may break machine&level save files. -->
<ID>e847c434-0ffb-456a-acf9-56800bcb2f77</ID>
</Mod>
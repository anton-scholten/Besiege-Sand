<Entity>
	<Debug>false</Debug>
	<ID>1</ID>
	<Name>Sand box</Name>
	<Fallback>Cottage</Fallback>

	<!-- A unit shape, so the editor's own scale handles read as the size of the
	     region and the amount of medium follows the volume. It is ten units across, one tall, and raised half of that,
	     so the object's own origin is the middle of its base: placed, it sits on the
	     surface that was clicked, and scaled, it grows up out of the ground instead of
	     down into it. (A placement <Offset> only lifts it once, when it is placed; the
	     editor scales about the origin, so the first resize buried half of it again.) -->
	<Mesh name="RegionBox_mesh">
		<Position x="0.0" y="0.5" z="0.0" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="10.0" y="1.0" z="10.0" />
	</Mesh>

	<Texture name="Sprayer_text" />
	<Icon name="SandBox_icon" />

	<Category>Virtual</Category>

	<!-- The editor click-tests against this. An object that cannot be picked
	     cannot be moved, whatever it looks like. A trigger, because the region is a
	     marker and not a wall: the editor's pick ray takes triggers, while the ground
	     raycasts and the sand's own collider feed skip them. The object is still there
	     while the level runs, with only its renderers hidden, so a solid box would be
	     measured as the ground under the region, have the sand laid on top of it, hold
	     that sand up invisibly and stop machines driving through it. -->
	<Colliders>
		<BoxCollider trigger="true">
			<Position x="0.0" y="0.5" z="0.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="10.0" y="1.0" z="10.0" />
		</BoxCollider>
	</Colliders>

	<ShowPhysicsToggle>false</ShowPhysicsToggle>

	<Triggers>
		<Trigger>LevelStart</Trigger>
		<Trigger>Variable</Trigger>
	</Triggers>
</Entity>
